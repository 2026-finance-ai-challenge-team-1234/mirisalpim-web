# 루트 공용 — 개별 backend/frontend/.gitignore 와 별개로, ai_core/data/ 등
# 저장소 최상위에 걸쳐 있는 항목을 여기서 관리한다.

__pycache__/
*.pyc
.env
.DS_Store
*.log

# RAG 코퍼스 원본 — 대용량·저작권 우려로 git 제외. data/README.md 참고.
# processed/ 는 추적한다(가공 결과물, 상대적으로 작고 재현 근거가 됨).
data/corpus/raw/

# 정확도 검증 라벨링 결과 (ai_core/eval) — 실행마다 생성되는 로그, 재현 근거는
# 커밋 메시지·PR 설명에 정확도 수치로 남긴다.
ai_core/eval/results/

# GCP 서비스 계정 키 — 보안상 git 제외.
.gcp-credentials.json
gcp-credentials.json

# 음성 POC 세션 로그 + 녹음 원본 (poc/voice_chat.py) — 실행마다 생성됨.
poc/results/

# 고정 음성 레이턴시 벤치마크 출력. 입력 음성은 명령에 로컬 경로로만 넘기며
# 저장소 안에 복사하지 않는다.
backend/benchmark-results/

# 로컬 개발 잔여물 — 이 프로젝트는 PostgreSQL 을 쓴다. sqlite 파일이 생겼다면
# DATABASE_URL 없이 manage.py 를 돌린 흔적이고, 안에 훈련 대화가 남는다
# (기획서 10절: 대화 원문은 세션 종료 시 파기).
backend/db.sqlite3

# 프론트는 frontend/ 안에서 관리한다. 저장소 최상위에 lock 파일이 생겼다면
# 루트에서 npm 을 잘못 돌린 것이다.
/package-lock.json
/node_modules/
