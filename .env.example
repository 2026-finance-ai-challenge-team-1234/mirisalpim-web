# Local development: copy this file to .env next to it (the mirisalpim-web root)
# and replace the placeholders. The root .env is the only one that is read, by
# both backend/config/settings.py and ai_core/config.py. Do not create
# backend/.env; a second file there would split the configuration in two.
# Railway: add the same names in the GitHub-linked application service's Variables tab.

# Django (required in production)
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
# Matches backend/docker-compose.yml for local development.
DATABASE_URL=postgresql://mirisalpim:localdev@localhost:5432/mirisalpim
ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.up.railway.app

# AI provider: ollama | anthropic | gemini
# Ollama is the local default. Railway must use gemini or anthropic unless an
# Ollama service is deployed separately.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a Gemini API key fallback.
GOOGLE_API_KEY=

# GCP service account key for Chirp STT/TTS. Separate from the Gemini API key
# above: this needs a service account with Speech-to-Text and Text-to-Speech
# enabled. Voice is optional, so a missing or malformed key logs a warning and
# the application still starts without voice.
#
# Local: uncomment and point at the key file; leave GCP_CREDENTIALS_JSON empty.
# Left commented so that a checkout without a key file starts without warnings.
# GOOGLE_APPLICATION_CREDENTIALS=.gcp-credentials.json
# Railway: set both. Railway has no file storage for secrets, so the key travels
# as JSON in GCP_CREDENTIALS_JSON and backend/runtime_credentials.py writes it to
# GOOGLE_APPLICATION_CREDENTIALS at container start. Paste the whole key file as
# a single minified line; keep the \n escapes inside private_key intact.
#   GCP_CREDENTIALS_JSON={"type":"service_account",...}
#   GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcp-credentials.json
GCP_CREDENTIALS_JSON=

# Voice latency diagnostics. Keep disabled in normal production traffic.
# When enabled, requests with ?timing=1 receive a final SSE `timing` event.
VOICE_LATENCY_DIAGNOSTICS=False
# Opening lines are scenario-static and safe to cache in memory (seconds).
OPENING_AUDIO_CACHE_SECONDS=86400

# Optional overrides
PORT=8000
# SCENARIO_SEED_DIR=C:/absolute/path/to/data/scenarios
