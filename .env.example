# Local development: copy this file to backend/.env and replace placeholders.
# Railway: add the same names in the GitHub-linked application service's Variables tab.

# Django (required in production)
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
# Matches backend/docker-compose.yml for local development.
DATABASE_URL=postgresql://scamvaccine:localdev@localhost:5432/scamvaccine
ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.up.railway.app

# AI provider: ollama | anthropic | gemini
# Ollama is the local default. Railway must use gemini or anthropic unless an
# Ollama service is deployed separately.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a Gemini API key fallback.
GOOGLE_API_KEY=

# Optional overrides
PORT=8000
# SCENARIO_SEED_DIR=C:/absolute/path/to/data/scenarios
